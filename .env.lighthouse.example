# Copy to .env.lighthouse (gitignored) and fill in. Never commit real values.
# One block per auth profile used in your routes file: LH_<PROFILE>_*
# Use dedicated TEST accounts — reports embed screenshots of the page.

# Preferred: the harness logs in through the real login page.
LH_PHARMACY_EMAIL=
LH_PHARMACY_PASSWORD=

# Fallback: paste the accessToken cookie value (expires ~30 min after login).
# LH_PHARMACY_ACCESS_TOKEN=

# Optional overrides
# LH_BASE_URL=http://localhost:3000
# LH_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
