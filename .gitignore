# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev notes
md/
.claude/
skills.md
strategy.md

# personal reference screenshots (kept locally, not tracked)
/public/processes-assigned to cashier.png
/public/weird background picture.png

# one-off scratch scripts / output dumps — never belong in the repo
/token.txt
/*.pat
/create_pr.js
/fix.js
/replace_all.js
/pr_output.log
/diff.txt
/tolocale_matches.txt
# lighthouse baseline harness
/lighthouse-reports/
.env.lighthouse
!.env.lighthouse.example
